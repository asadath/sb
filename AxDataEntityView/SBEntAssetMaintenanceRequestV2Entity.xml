				<Source><![CDATA[
    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        super(_entityCtx, _dataSourceCtx);

        switch (_dataSourceCtx.name())
        {
            case dataEntityDataSourceStr(EntAssetMaintenanceRequestV2Entity, ObjectTable):

                if(this.MaintenanceAssetId)
                {
                    EntAssetRequestTable request = _entityCtx.getRuntimeContextByName(dataEntityDataSourceStr(EntAssetMaintenanceRequestV2Entity, EntAssetRequestTable)).getBuffer();
                    EntAssetFunctionalLocationObject functionalLocationObject     = EntAssetFunctionalLocationObject::findByObject(EntAssetObjectTable::find(this.MaintenanceAssetId).RecId);
                    EntAssetFunctionalLocation functionalLocation = functionalLocationObject.functionalLocation();

                    request.FunctionalLocationObject = functionalLocationObject.RecId;
                    request.FunctionalLocation = functionalLocation.RecId;
                }

                break;
        }
    }

]]></Source>
