			<Method>
				<Name>updateRequestLifecycleState</Name>
				<Source><![CDATA[
    [SysODataAction('UpdateState', false), Hookable(false)]
    public static void updateRequestLifecycleState(Common _request, EntAssetLifecycleStateId _nextStateId)
    {
        EntAssetRequestLifecycleState nextState = EntAssetRequestLifecycleState::findID(_nextStateId);
        EntAssetRequestTable request = _request as EntAssetRequestTable;

        if (nextState.RecId != 0
            && request != null
            && request.RequestLifecycleState != nextState.RecId)
        {
            EntAssetLifecycleStateUpdate stateUpdate = EntAssetLifecycleStateUpdate::construct(tableId2Name(request.TableId));
            EntAssetLifecycleStateMap stateMap = nextState;
            stateUpdate.parmNewLifecycleState(stateMap);
            stateUpdate.parmRemark("@EnterpriseAssetManagementAppSuite:StageUpdatedFromEntity");
            stateUpdate.parmSkipDialog(true);
            stateUpdate.addRecord(request.RecId);
            stateUpdate.updateLifecycleState();
            request.reread();
        }
    }

]]></Source>
