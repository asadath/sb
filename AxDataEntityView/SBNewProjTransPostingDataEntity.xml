]]></Declaration>
		<Methods>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void postLoad()
    {
        ProjTransPosting projTransPosting;
        super();

        select firstonly AmountMST, Voucher, ProjTransDate from projTransPosting
                order by projTransPosting.ProjTransDate desc
            where projTransPosting.TransId == this.TransId
               && projTransPosting.ProjId == this.ProjectId
               && projTransPosting.ActivityNumber == this.ActivityNumber;

        this.Voucher                    = projTransPosting.Voucher;
        this.TotalProjectCostAmountCur  = projTransPosting.AmountMst;
        this.ProjTransDate              = projTransPosting.ProjTransDate;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
