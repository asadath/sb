    {
        Query changeTrackingQuery = new Query();
        
        QueryBuildDataSource docuRefDS = EcoResProductEntityChangeTrackingHelper::addDocuRefAndRelationLinks(changeTrackingQuery);

        QueryBuildDataSource maintenancePlanLineTableDS =  docuRefDS.addDataSource(tableNum(EntAssetMaintenancePlanLine));
        maintenancePlanLineTableDS.joinMode(JoinMode::InnerJoin);
        maintenancePlanLineTableDS.fetchMode(QueryFetchMode::One2One);
        maintenancePlanLineTableDS.relations(false);
        maintenancePlanLineTableDS.addLink(fieldNum(DocuRef, RefCompanyId), fieldNum(EntAssetRequestTable, DataAreaId), docuRefDS.name());
        maintenancePlanLineTableDS.addLink(fieldNum(DocuRef, RefTableId), fieldNum(EntAssetRequestTable, TableId), docuRefDS.name());
        maintenancePlanLineTableDS.addLink(fieldNum(DocuRef, RefRecId), fieldNum(EntAssetRequestTable, RecId), docuRefDS.name());

        return changeTrackingQuery;
    }

]]></Source>
